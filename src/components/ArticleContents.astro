---
import type { MarkdownHeading } from "astro";
import { homePath, translator, type Language } from "../i18n";
import type { getPostConnections } from "../lib/post-links";
interface Props {
  headings: MarkdownHeading[];
  lang: Language;
  backlinks: ReturnType<typeof getPostConnections>["backlinks"];
  compact?: boolean;
}
const { headings, backlinks, lang, compact = false } = Astro.props;
const t = translator(lang);
const backlinksId = compact ? "mobile-backlinks" : "backlinks";
const baseDepth = headings.length
  ? Math.min(...headings.map((heading) => heading.depth))
  : 2;
---

<nav
  class="article-toc"
  aria-label={lang === "th" ? "ในบทความนี้" : "On this page"}
>
  <a class="toc-home" href={homePath(lang)}>
    <span class="icon-[lucide--arrow-left]" aria-hidden="true"></span>
    {t("article.back")}
  </a>
  {headings.length > 0 && (
    <h2 class:list={{ "sr-only": compact }}>
      {lang === "th" ? "ในบทความนี้" : "On this page"}
    </h2>
  )}
  <ol>
    {headings.map((heading) => (
      <li style={`padding-inline-start: ${(heading.depth - baseDepth) * 12}px`}>
        <a href={`#${heading.slug}`}>{heading.text}</a>
      </li>
    ))}
  </ol>
  <section
    class="toc-backlinks"
    id={backlinksId}
    data-post-backlinks
    aria-labelledby={`${backlinksId}-heading`}
  >
    <h2 id={`${backlinksId}-heading`}>
      <span class="icon-[lucide--corner-down-left]" aria-hidden="true"></span>
      {t("article.backlinks")}
      <span class="backlink-count">{backlinks.length}</span>
    </h2>
    {backlinks.length ? (
      <ul>
        {backlinks.map((link) => (
          <li>
            <a href={link.href}>
              <span lang={link.lang}>{link.title}</span>
              {link.lang !== lang && (
                <span class="backlink-language">{link.lang.toUpperCase()}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p>{t("article.noBacklinks")}</p>
    )}
  </section>
</nav>
<style>
  .article-toc .toc-home {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    color: var(--accent);
    font-size: 14px;
  }
  .article-toc h2 {
    font-size: 14px;
    margin: 0 0 12px;
  }
  .article-toc ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .article-toc li {
    margin: 4px 0;
    color: var(--muted);
    font-size: 14px;
  }
  .article-toc a {
    display: block;
    padding: 7px 0;
    line-height: 1.5;
  }
  .article-toc a:hover,
  .article-toc a:focus-visible {
    color: var(--accent);
  }
  .toc-backlinks {
    border-top: 1px solid var(--line);
    margin-top: 18px;
    padding-top: 18px;
  }
  .toc-backlinks h2 {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--accent);
    line-height: 1.6;
  }
  .toc-backlinks h2 > [aria-hidden] {
    flex-shrink: 0;
  }
  .backlink-count {
    margin-left: auto;
    padding: 0 6px;
    border-radius: 5px;
    background: var(--accent-soft);
    font-size: 11px;
  }
  .toc-backlinks ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc-backlinks a {
    overflow-wrap: anywhere;
  }
  .toc-backlinks p,
  .backlink-language {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
    margin: 0;
  }
  .backlink-language {
    margin-left: 6px;
  }
</style>
