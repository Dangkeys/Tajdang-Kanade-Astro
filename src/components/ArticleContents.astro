---
import type { MarkdownHeading } from "astro";
import { homePath, translator, type Language } from "../i18n";
interface Props {
  headings: MarkdownHeading[];
  lang: Language;
  compact?: boolean;
}
const { headings, lang, compact = false } = Astro.props;
const t = translator(lang);
const baseDepth = headings.length
  ? Math.min(...headings.map((heading) => heading.depth))
  : 2;
---

<nav
  class="article-toc"
  aria-label={lang === "th" ? "ในบทความนี้" : "On this page"}
>
  <a class="toc-home" href={homePath(lang)}>
    <span class="icon-[lucide--arrow-left]" aria-hidden="true"></span>
    {t("article.back")}
  </a>
  {headings.length > 0 && (
    <h2 class:list={{ "sr-only": compact }}>
      {lang === "th" ? "ในบทความนี้" : "On this page"}
    </h2>
  )}
  <ol>
    {headings.map((heading) => (
      <li style={`padding-inline-start: ${(heading.depth - baseDepth) * 12}px`}>
        <a href={`#${heading.slug}`}>{heading.text}</a>
      </li>
    ))}
  </ol>
</nav>
<style>
  .article-toc .toc-home {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    color: var(--accent);
    font-size: 14px;
  }
  .article-toc h2 {
    font-size: 14px;
    margin: 0 0 12px;
  }
  .article-toc ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .article-toc li {
    margin: 4px 0;
    color: var(--muted);
    font-size: 14px;
  }
  .article-toc a {
    display: block;
    padding: 7px 0;
    line-height: 1.5;
  }
  .article-toc a:hover,
  .article-toc a:focus-visible {
    color: var(--accent);
  }
</style>
