---
import type { getPostConnections } from "../lib/post-links";
import { translator, type Language } from "../i18n";

interface Props {
  links: ReturnType<typeof getPostConnections>["outgoing"];
  lang: Language;
}

const { links, lang } = Astro.props;
const t = translator(lang);
---

<section
  class="post-connections"
  id="outgoing-links"
  aria-labelledby="connections-heading"
>
  <h2 id="connections-heading">
    <span class="icon-[lucide--arrow-up-right]" aria-hidden="true"></span>
    {t("article.connections")}
    <span class="connection-count">{links.length}</span>
  </h2>
  {links.length ? (
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href}>
            <span class="connection-title">
              <span lang={link.kind === "post" ? link.lang : undefined}>
                {link.title}
              </span>
              {link.kind === "post" && link.lang !== lang && (
                <span class="connection-language">
                  {link.lang.toUpperCase()}
                </span>
              )}
            </span>
            <span class="connection-description">{link.description}</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="connection-empty">{t("article.noOutgoingLinks")}</p>
  )}
</section>

<style>
  .post-connections {
    margin-top: 36px;
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }
  h2 {
    margin: 0 0 18px;
    font-size: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    line-height: 1.6;
  }
  h2 > [aria-hidden] {
    flex-shrink: 0;
  }
  .connection-count {
    margin-left: auto;
    padding: 0 7px;
    border-radius: 6px;
    background: var(--accent-soft);
    font-size: 12px;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  li {
    min-width: 0;
  }
  a {
    display: block;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow-wrap: anywhere;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  a:hover,
  a:focus-visible {
    background: var(--accent-soft);
    border-color: var(--accent);
  }
  .connection-title {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
  }
  .connection-description,
  .connection-empty {
    display: block;
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
  }
  .connection-language {
    font-size: 10px;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
