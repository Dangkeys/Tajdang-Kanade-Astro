---
import { render, type CollectionEntry } from "astro:content";
import { tagBreadcrumb } from "../lib/tags";
import MediaCarousel from "./MediaCarousel.vue";
import BaseLayout from "../layouts/BaseLayout.astro";
import { translator, homePath, type Language } from "../i18n";
interface Props {
  post: CollectionEntry<"posts">;
  lang: Language;
}
const { post, lang } = Astro.props;
const t = translator(lang);
const { Content, headings } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  heroTitle={post.data.title}
  heroSubtitle={post.data.description}
  lang={lang}
  article
>
  <div class="shell reading-shell">
    <article class="card portfolio-article">
      <a class="text-link" href={homePath(lang)}>
        {t("article.back")}
      </a>
      <div class="article-heading">
        <span class="eyebrow">TAJDANG / {post.data.category}</span>
        <h1>{post.data.title}</h1>
        <div class="article-tags">
          {post.data.tags.map((tag) => (
            <a
              class="chip"
              href={`${homePath(lang)}?tag=${encodeURIComponent(tag)}`}
            >
              {tagBreadcrumb(tag)}
            </a>
          ))}
        </div>
      </div>
      {post.data.media.length > 0 && (
        <MediaCarousel items={post.data.media} lang={lang} client:load />
      )}
      <div class="prose" id="article-body">
        <Content />
      </div>
      <div class="section-rule"></div>
      <p class="muted">{t("article.thanks")}</p>
    </article>
    <aside class="article-sidebar">
      <nav
        class="card article-navigation"
        aria-label={lang === "th" ? "เมนูนำทาง" : "Portfolio navigation"}
      >
        {headings.length > 0 && (
          <div class="article-toc">
            <h2>{lang === "th" ? "ในบทความนี้" : "On this page"}</h2>
            <ol>
              {headings
                .filter((heading) => heading.depth <= 3)
                .map((heading) => (
                  <li class:list={{ nested: heading.depth === 3 }}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
            </ol>
          </div>
        )}
      </nav>
    </aside>
  </div>
</BaseLayout>
<style>
  .reading-shell {
    max-width: 1200px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 24px;
    align-items: start;
    padding-top: 24px;
    padding-bottom: 60px;
  }
  .portfolio-article {
    padding: clamp(24px, 5vw, 56px);
  }
  .article-heading {
    margin: 28px 0;
  }
  .article-heading h1 {
    font-size: clamp(26px, 4vw, 38px);
    line-height: 1.3;
    margin: 12px 0 20px;
  }
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .prose {
    font-size: 16px;
  }
  .article-sidebar {
    position: sticky;
    top: 24px;
  }
  .article-navigation {
    padding: 22px;
  }
  .article-navigation a:hover {
    color: var(--accent);
  }
  .article-toc h2 {
    font-size: 14px;
    margin: 0 0 12px;
  }
  .article-toc ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .article-toc li {
    margin: 10px 0;
    color: var(--muted);
    font-size: 13px;
  }
  .article-toc .nested {
    padding-left: 12px;
  }
  @media (max-width: 800px) {
    .reading-shell {
      display: flex;
      flex-direction: column;
    }
    .portfolio-article {
      width: 100%;
    }
    .article-sidebar {
      position: static;
      width: 100%;
    }
  }
</style>
