---
import { render, type CollectionEntry } from "astro:content";
import { tagBreadcrumb } from "../lib/tags";
import { optimizedImageUrl } from "../lib/images";
import ArticleContents from "./ArticleContents.astro";
import MediaCarousel from "./MediaCarousel.vue";
import BaseLayout from "../layouts/BaseLayout.astro";
import { translator, homePath, type Language } from "../i18n";
interface Props {
  post: CollectionEntry<"posts">;
  lang: Language;
}
const { post, lang } = Astro.props;
const t = translator(lang);
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const media = await Promise.all(
  post.data.media.map(async (item) =>
    item.type === "image"
      ? { ...item, src: await optimizedImageUrl(item.src, 1000) }
      : item,
  ),
);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  heroTitle={post.data.title}
  heroSubtitle={post.data.description}
  lang={lang}
  article
>
  <div class="shell reading-shell">
    {tocHeadings.length > 0 && (
      <details class="card mobile-article-nav">
        <summary>
          <span class="icon-[lucide--list]" aria-hidden="true"></span>
          {lang === "th" ? "ในบทความนี้" : "On this page"}
          <span
            class="toc-chevron icon-[lucide--chevron-down]"
            aria-hidden="true"
          ></span>
        </summary>
        <div class="mobile-toc-content">
          <ArticleContents headings={tocHeadings} lang={lang} compact />
        </div>
      </details>
    )}
    <article class="card portfolio-article">
      <a class="text-link" href={homePath(lang)}>
        {t("article.back")}
      </a>
      <div class="article-heading">
        <span class="eyebrow">TAJDANG / {post.data.category}</span>
        <h1>{post.data.title}</h1>
        <div class="article-tags">
          {post.data.tags.map((tag) => (
            <a
              class="chip"
              href={`${homePath(lang)}?tag=${encodeURIComponent(tag)}`}
            >
              {tagBreadcrumb(tag)}
            </a>
          ))}
        </div>
      </div>
      {post.data.media.length > 0 && (
        <MediaCarousel items={media} lang={lang} client:load />
      )}
      <div class="prose" id="article-body">
        <Content />
      </div>
      <div class="section-rule"></div>
      <p class="muted">{t("article.thanks")}</p>
    </article>
    {tocHeadings.length > 0 && (
      <aside class="article-sidebar card article-navigation">
        <ArticleContents headings={tocHeadings} lang={lang} />
      </aside>
    )}
  </div>
</BaseLayout>
<style>
  .reading-shell {
    max-width: 1200px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 24px;
    align-items: start;
    padding-top: 24px;
    padding-bottom: 60px;
  }
  .portfolio-article {
    padding: clamp(24px, 5vw, 56px);
  }
  .article-heading {
    margin: 28px 0;
  }
  .article-heading h1 {
    font-size: clamp(26px, 4vw, 38px);
    line-height: 1.3;
    margin: 12px 0 20px;
  }
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .prose {
    font-size: 16px;
  }
  .article-sidebar {
    position: sticky;
    top: 24px;
  }
  .article-navigation {
    padding: 22px;
  }
  .mobile-article-nav {
    display: none;
  }
  @media (max-width: 800px) {
    .reading-shell {
      display: flex;
      flex-direction: column;
    }
    .portfolio-article {
      width: 100%;
    }
    .article-sidebar {
      display: none;
    }
    .mobile-article-nav {
      display: block;
      position: sticky;
      top: 10px;
      z-index: 20;
      width: 100%;
    }
    .mobile-article-nav summary {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 48px;
      padding: 12px 16px;
      cursor: pointer;
      list-style: none;
      color: var(--accent);
      font-size: 14px;
    }
    .mobile-article-nav summary::-webkit-details-marker {
      display: none;
    }
    .toc-chevron {
      margin-left: auto;
      transition: transform 0.2s;
    }
    .mobile-article-nav[open] .toc-chevron {
      transform: rotate(180deg);
    }
    .mobile-toc-content {
      max-height: 45dvh;
      overflow-y: auto;
      padding: 0 16px 12px;
      border-top: 1px solid var(--line);
      overscroll-behavior: contain;
    }
    .portfolio-article {
      min-width: 0;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const menu = document.querySelector<HTMLDetailsElement>(
      ".mobile-article-nav",
    );
    menu?.addEventListener("click", (event) => {
      if (
        event.target instanceof Element &&
        event.target.closest('a[href^="#"]')
      )
        menu.open = false;
    });
  });
</script>
