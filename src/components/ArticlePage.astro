---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { tagBreadcrumb } from "../lib/tags";
import { optimizedImageUrl } from "../lib/images";
import ArticleContents from "./ArticleContents.astro";
import SeriesNavigation from "./SeriesNavigation.astro";
import { getPostId } from "../lib/post-paths";
import MediaCarousel from "./MediaCarousel.vue";
import PostConnections from "./PostConnections.astro";
import { getPostConnections } from "../lib/post-links";
import BaseLayout from "../layouts/BaseLayout.astro";
import { translator, homePath, type Language } from "../i18n";
interface Props {
  post: CollectionEntry<"posts">;
  lang: Language;
}
const { post, lang } = Astro.props;
const t = translator(lang);
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const allPosts = await getCollection("posts");
const series = post.data.series;
const seriesItems = series
  ? allPosts
      .filter(
        (entry) =>
          !entry.data.draft &&
          entry.data.lang === lang &&
          entry.data.series?.id === series.id,
      )
      .sort(
        (a, b) => (a.data.series?.episode ?? 0) - (b.data.series?.episode ?? 0),
      )
      .map((entry) => ({
        title: entry.data.title,
        href: `${homePath(lang)}posts/${getPostId(entry).split("/").map(encodeURIComponent).join("/")}/`,
        episode: entry.data.series?.episode ?? 1,
        current: entry.id === post.id,
      }))
  : [];
const { outgoing, backlinks } = getPostConnections({
  post,
  posts: allPosts,
  site: Astro.site ?? Astro.url,
});
const media = await Promise.all(
  post.data.media.map(async (item) =>
    item.type === "image"
      ? { ...item, src: await optimizedImageUrl(item.src, 1000) }
      : item,
  ),
);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  heroTitle={post.data.title}
  heroSubtitle={post.data.description}
  lang={lang}
  article
>
  <div class:list={["shell reading-shell", { "has-series": Boolean(series) }]}>
    {series && (
      <>
        <aside class="card series-sidebar">
          <SeriesNavigation
            name={series.name[lang]}
            lang={lang}
            items={seriesItems}
          />
        </aside>
        <details class="card series-mobile">
          <summary>
            {series.name[lang]} ·{" "}
            {lang === "th" ? "ตอนทั้งหมด" : "All episodes"}
          </summary>
          <SeriesNavigation
            name={series.name[lang]}
            lang={lang}
            items={seriesItems}
          />
        </details>
      </>
    )}
    <details class="card mobile-article-nav">
      <summary>
        <span class="icon-[lucide--list]" aria-hidden="true"></span>
        {lang === "th" ? "ในบทความนี้" : "On this page"}
        <span
          class="toc-chevron icon-[lucide--chevron-down]"
          aria-hidden="true"
        ></span>
      </summary>
      <div class="mobile-toc-content">
        <ArticleContents
          headings={tocHeadings}
          backlinks={backlinks}
          lang={lang}
          compact
        />
      </div>
    </details>
    <article class="card portfolio-article">
      <div class="article-heading">
        <span class="eyebrow">TAJDANG / {post.data.category}</span>
        <h1>{post.data.title}</h1>
        <div class="article-tags">
          {post.data.tags.map((tag) => (
            <a
              class="chip"
              href={`${homePath(lang)}?tag=${encodeURIComponent(tag)}`}
            >
              {tagBreadcrumb(tag)}
            </a>
          ))}
        </div>
      </div>
      {post.data.media.length > 0 && (
        <MediaCarousel items={media} lang={lang} client:load />
      )}
      <div class="prose" id="article-body">
        <Content />
      </div>
      <PostConnections links={outgoing} lang={lang} />
      <div class="section-rule"></div>
      <p class="muted">{t("article.thanks")}</p>
      <a class="btn secondary article-home" href={homePath(lang)}>
        <span class="icon-[lucide--arrow-left]" aria-hidden="true"></span>
        {t("article.back")}
      </a>
    </article>
    <aside class="article-sidebar card article-navigation">
      <ArticleContents
        headings={tocHeadings}
        backlinks={backlinks}
        lang={lang}
      />
    </aside>
  </div>
</BaseLayout>
<style>
  .reading-shell {
    max-width: 1200px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 24px;
    align-items: start;
    padding-top: 24px;
    padding-bottom: 60px;
  }
  .portfolio-article {
    padding: clamp(24px, 5vw, 56px);
  }
  .reading-shell.has-series {
    max-width: 1480px;
    grid-template-columns: 220px minmax(0, 1fr) 240px;
  }
  .series-sidebar {
    position: sticky;
    top: 24px;
    max-height: calc(100dvh - 48px);
    overflow-y: auto;
  }
  .series-mobile {
    display: none;
  }
  .series-mobile summary {
    padding: 12px 18px;
    color: var(--accent);
    cursor: pointer;
  }
  @media (max-width: 1200px) {
    .reading-shell.has-series {
      max-width: 1200px;
      grid-template-columns: minmax(0, 1fr) 240px;
    }
    .series-sidebar {
      display: none;
    }
    .series-mobile {
      display: block;
      grid-column: 1 / -1;
      width: 100%;
    }
  }
  .article-heading {
    margin: 28px 0;
  }
  .article-heading h1 {
    font-size: clamp(26px, 4vw, 38px);
    line-height: 1.3;
    margin: 12px 0 20px;
  }
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .prose {
    font-size: 16px;
  }
  .article-sidebar {
    position: sticky;
    top: 24px;
    max-height: calc(100dvh - 48px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .article-navigation {
    padding: 22px;
  }
  .article-home {
    margin-top: 16px;
  }
  .mobile-article-nav {
    display: none;
  }
  @media (max-width: 800px) {
    .reading-shell {
      display: flex;
      flex-direction: column;
    }
    .portfolio-article {
      width: 100%;
    }
    .article-sidebar {
      display: none;
    }
    .mobile-article-nav {
      display: block;
      position: sticky;
      top: 10px;
      z-index: 20;
      width: 100%;
    }
    .mobile-article-nav summary {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 48px;
      padding: 12px 16px;
      cursor: pointer;
      list-style: none;
      color: var(--accent);
      font-size: 14px;
    }
    .mobile-article-nav summary::-webkit-details-marker {
      display: none;
    }
    .toc-chevron {
      margin-left: auto;
      transition: transform 0.2s;
    }
    .mobile-article-nav[open] .toc-chevron {
      transform: rotate(180deg);
    }
    .mobile-toc-content {
      max-height: 45dvh;
      overflow-y: auto;
      padding: 0 16px 12px;
      border-top: 1px solid var(--line);
      overscroll-behavior: contain;
    }
    .portfolio-article {
      min-width: 0;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const menu = document.querySelector<HTMLDetailsElement>(
      ".mobile-article-nav",
    );
    menu?.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a[href]"))
        menu.open = false;
    });
  });
</script>
