---
import { optimizedImageUrl } from "../lib/images";
import { personalInfo } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
import Portfolio from "./Portfolio.vue";
import { getPosts, summarize } from "../lib/posts";
import type { Language } from "../i18n";
interface Props {
  lang?: Language;
}
const { lang = "en" } = Astro.props;
const posts = await Promise.all(
  (await getPosts(lang)).map(async (post) => {
    const summary = summarize(post);
    return {
      ...summary,
      coverImage: summary.coverImage
        ? await optimizedImageUrl(summary.coverImage, 720)
        : undefined,
    };
  }),
);
const [avatarSrc, portraitSrc] = await Promise.all([
  optimizedImageUrl(personalInfo.avatar, 176),
  optimizedImageUrl("/images/taj-portrait.png", 480),
]);
---

<BaseLayout home lang={lang}>
  <Portfolio
    posts={posts}
    lang={lang}
    avatarSrc={avatarSrc}
    portraitSrc={portraitSrc}
    client:load
  />
</BaseLayout>
