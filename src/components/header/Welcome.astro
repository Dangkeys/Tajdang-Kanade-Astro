---
import { translator, type Language } from "../../i18n";
import { welcomeConfig } from "../../config";
import Waves from "./Waves.vue";
interface Props {
  lang?: Language;
  compact?: boolean;
  title?: string;
  subtitle?: string;
  headingLevel?: 1 | 2;
}
const {
  lang = "en",
  compact = false,
  title,
  subtitle,
  headingLevel = 1,
} = Astro.props;
const t = translator(lang);
const Heading = headingLevel === 1 ? "h1" : "h2";
---

<section
  class:list={["welcome-section", { compact }]}
  style={`background-image: url('${welcomeConfig.bgImage}')`}
  aria-label={title || welcomeConfig.title}
>
  <div class="hero-shade"></div>
  <canvas class="hero-cursor-trail" aria-hidden="true"></canvas>
  <div class="hero-content">
    <span class="hero-eyebrow">
      {compact ? t("hero.pageEyebrow") : t("hero.homeEyebrow")}
    </span>
    <Heading class="hero-title">
      {title || welcomeConfig.title}
      <span class="hero-sparkle" aria-hidden="true">
        ✧
      </span>
    </Heading>
    <p>{subtitle || welcomeConfig.subTitle}</p>
    {!compact && (
      <a href="#main-content" class="hero-explore">
        {t("hero.explore")}{" "}
        <span class="icon-[lucide--arrow-down]" aria-hidden="true"></span>
      </a>
    )}
  </div>
  <span class="hero-side-note" aria-hidden="true">
    {t("hero.sideNote")}
  </span>
  <Waves class="hero-waves" />
</section>
<script>
  import { attachHeroTrail } from "../../scripts/hero-trail";
  let disposeTrail: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    disposeTrail?.();
    const hero = document.querySelector<HTMLElement>(".welcome-section");
    disposeTrail = hero ? attachHeroTrail(hero) : undefined;
  });
  document.addEventListener("astro:before-swap", () => {
    disposeTrail?.();
    disposeTrail = undefined;
  });
</script>
<style>
  .hero-cursor-trail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce), (hover: none) {
    .hero-cursor-trail {
      display: none;
    }
  }

  .hero-content {
    animation: hero-arrive 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero-sparkle {
    animation: sparkle-drift 4s ease-in-out infinite;
  }
  @keyframes hero-arrive {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes sparkle-drift {
    0%,
    100% {
      transform: translateY(0) rotate(0);
    }
    50% {
      transform: translateY(-7px) rotate(12deg);
    }
  }

  .welcome-section {
    position: relative;
    height: 450px;
    background-size: cover;
    background-position: center 43%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    overflow: hidden;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, #2b223550, #2b22352e 50%, #2b223560);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    padding: 25px 20px 55px;
    text-shadow: 0 2px 18px #2b223580;
  }
  .hero-eyebrow {
    display: block;
    font-family: "Oxanium-Medium", var(--font-body);
    font-size: 11px;
    letter-spacing: 0.28em;
    opacity: 0.92;
    margin-bottom: 19px;
  }
  .hero-content .hero-title {
    margin: 0 0 10px;
    font-size: clamp(30px, 3.5vw, 46px);
    letter-spacing: 0.06em;
    font-weight: 600;
    line-height: 1.5;
  }
  .hero-sparkle {
    display: inline-block;
    font-size: 33px;
    margin-left: 12px;
    vertical-align: top;
    color: var(--hero-highlight);
  }
  .hero-content p {
    font-size: 15px;
    letter-spacing: 0.16em;
    margin: 8px 0 23px;
  }
  .hero-explore {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    border: 1px solid #ffffff65;
    background: #ffffff12;
    padding: 8px 18px;
    border-radius: 30px;
    font-size: 11px;
    letter-spacing: 0.05em;
    backdrop-filter: blur(5px);
  }
  .hero-explore:hover {
    background: #ffffff30;
    transform: translateY(2px);
  }
  .hero-side-note {
    position: absolute;
    right: 26px;
    top: 42%;
    writing-mode: vertical-rl;
    font-family: "Oxanium-Medium", var(--font-body);
    font-size: 9px;
    letter-spacing: 0.22em;
    opacity: 0.65;
  }
  .hero-waves {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    z-index: 1;
  }
  .hero-waves svg {
    height: 70px;
    min-height: 70px;
  }
  .welcome-section.compact {
    height: 290px;
  }
  .compact .hero-content {
    padding-top: 72px;
  }
  .compact .hero-content .hero-title {
    font-size: 34px;
  }
  .compact .hero-eyebrow {
    font-size: 10px;
    margin-bottom: 10px;
  }
  .compact .hero-content p {
    font-size: 13px;
  }
  @media (max-width: 760px) {
    .welcome-section {
      height: 380px;
      background-position: 40% center;
    }
    .hero-content {
      padding-top: 50px;
    }
    .hero-content p {
      font-size: 12px;
      letter-spacing: 0.06em;
    }
    .hero-content .hero-title {
      font-size: 30px;
    }
    .hero-sparkle {
      font-size: 24px;
      margin-left: 5px;
    }
    .hero-side-note {
      display: none;
    }
    .welcome-section.compact {
      height: 260px;
    }
    .compact .hero-content .hero-title {
      font-size: 28px;
    }
  }
</style>
