---
import { ClientRouter } from "astro:transitions";
import { translator, homePath, type Language } from "../i18n";
import { siteInfo, personalInfo } from "../config";
import Welcome from "../components/header/Welcome.astro";
import "../styles/global.css";
import "@fontsource-variable/noto-sans";
import "@fontsource-variable/noto-sans-thai";
import "@fontsource-variable/jetbrains-mono";
interface Props {
  title?: string;
  description?: string;
  heroTitle?: string;
  heroSubtitle?: string;
  home?: boolean;
  article?: boolean;
  publishedTime?: string;
  noindex?: boolean;
  lang?: Language;
}
const {
  lang = "en",
  title,
  home = false,
  article = false,
  noindex = false,
  description,
  heroTitle,
  heroSubtitle,
} = Astro.props;
const t = translator(lang);
const canonical = new URL(Astro.url.pathname, siteInfo.url);
const alternate =
  lang === "th"
    ? Astro.url.pathname.replace(/^\/th/, "") || "/"
    : `/th${Astro.url.pathname}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={siteInfo.favicon} type="image/svg+xml" />
    <meta name="description" content={description || t("site.description")} />
    <meta name="theme-color" content="#241e2e" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang={lang === "th" ? "en" : "th"}
      href={new URL(alternate, siteInfo.url)}
    />
    <meta property="og:title" content={title || t("hero.title")} />
    <meta
      property="og:description"
      content={description || t("site.description")}
    />
    <meta
      property="og:image"
      content={new URL("/images/L.png", siteInfo.url)}
    />
    <title>{title ? `${title} · Tajdang` : `Tajdang · ${t("site.titleSuffix")}`}</title>
    <script is:inline>
      function restoreTheme() {
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        document.documentElement.classList.toggle(
          "dark",
          theme === "dark" ||
            (theme !== "light" &&
              matchMedia("(prefers-color-scheme: dark)").matches),
        );
      }
      restoreTheme();
      document.addEventListener("astro:after-swap", restoreTheme);
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {t("common.skip")}
    </a>
    <div class="portfolio-controls">
      {!home && (
        <a href={homePath(lang)} class="control-home">
          {t("nav.home")}
        </a>
      )}
      <a
        class="language-control"
        href={`${alternate}${Astro.url.search}`}
        hreflang={lang === "th" ? "en" : "th"}
        aria-label={lang === "en" ? "เปลี่ยนเป็นภาษาไทย" : "Switch to English"}
      >
        <span class:list={{ current: lang === "en" }}>EN</span>
        <span aria-hidden="true">/</span>
        <span class:list={{ current: lang === "th" }}>TH</span>
      </a>
      <button
        class="theme-control"
        aria-label={lang === "en" ? "Change color theme" : "เปลี่ยนธีมสี"}
      >
        <span class="icon-[lucide--sun-moon]" aria-hidden="true"></span>
      </button>
    </div>
    <Welcome
      compact={!home}
      headingLevel={article ? 2 : 1}
      title={heroTitle || t("hero.title")}
      subtitle={heroSubtitle || t("hero.subtitle")}
      lang={lang}
    />
    <main id="main-content" tabindex="-1" transition:animate="slide">
      <slot />
    </main>
    <footer class="site-footer">
      <a class="footer-mark" href={homePath(lang)}>
        Tajdang<span class="accent">.</span>
      </a>
      <p>{t("footer.message")}</p>
      <p>
        © {new Date().getFullYear()} Tajdang ·{" "}
        {lang === "en" ? "A personal fork of" : "เว็บไซต์ส่วนตัวที่ต่อยอดจาก"}{" "}
        <a
          class="accent"
          href="https://github.com/sudoriaa/Kanade-Astro"
          target="_blank"
          rel="noopener noreferrer"
        >
          Kanade
        </a>{" "}
        ·{" "}
        {lang === "en"
          ? "Explore the original open source theme."
          : "ลองดูธีมโอเพนซอร์สต้นฉบับได้เลยครับ"}
      </p>
      <a
        class="text-link"
        href={personalInfo.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
    </footer>
    <script>
      import { toggleTheme } from "../scripts/theme";
      document.addEventListener("astro:page-load", () => {
        document
          .querySelector(".theme-control")
          ?.addEventListener("click", () => toggleTheme());
      });
    </script>
  </body>
</html>
<style>
  .portfolio-controls {
    position: absolute;
    z-index: 30;
    top: 20px;
    right: clamp(16px, 4vw, 60px);
    display: flex;
    gap: 12px;
    align-items: center;
    color: #fffaf2;
  }
  .portfolio-controls a,
  .portfolio-controls button {
    border: 1px solid #ffffff55;
    border-radius: 30px;
    background: #2b223570;
    color: inherit;
    backdrop-filter: blur(12px);
    padding: 8px 15px;
    font-size: 14px;
  }
  .language-control {
    display: flex;
    gap: 8px;
  }
  .language-control span {
    opacity: 0.55;
  }
  .language-control .current {
    opacity: 1;
    font-weight: 700;
  }
  .portfolio-controls .theme-control {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    font-size: 20px;
  }
</style>
